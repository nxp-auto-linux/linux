menu "ARM SCMI NXP S32 Vendor Protocols"

config S32_ARM_SCMI_PINCTRL
	bool
	depends on SOC_S32CC
	default y
	help
	  Adds S32 common chassis platforms pinctrl extension over SCMI.

	  Say N if you are unsure.

config S32_ARM_SCMI_NVMEM
	bool
	depends on SOC_S32CC
	default y
	help
	  Adds S32 common chassis platforms nvmem extension over SCMI.

	  Say N if you are unsure.

config S32_ARM_SCMI_GPIO
	bool
	depends on SOC_S32CC
	default y
	help
	  Adds S32 common chassis platforms GPIO extension over SCMI.

	  Say N if you are unsure.

config S32_ARM_SCMI_NXP_MISC
	bool "NXP Miscellaneous SCMI Vendor Protocol Extension"
	depends on ARM_SCMI_PROTOCOL || COMPILE_TEST
	help
	  Adds NXP Miscellaneous vendor protocol extension over SCMI for
	  S32N7-based platforms.

	  Say N if unsure.
endmenu

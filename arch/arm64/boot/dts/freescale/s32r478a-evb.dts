/*
 * Device Tree file for NXP S32R47.
 *
 * Copyright 2025-2026 NXP
 */

#include "s32r47.dtsi"
#include "s32r47-nxp-flash-micron.dtsi"

/ {
	model = "NXP S32R478AEVB";
	compatible = "nxp,s32r47";

	tick-timer = &pit2;
};

&gmac0 {
	clocks = <&sys_clk>,
		 <&sys_clk>,
		 <&gmac_ts_clk>;
	clock-names = "stmmaceth", "pclk", "ptp_ref";
	phy-handle = <&mdio_gmac0_phy1>;
	phy-mode = "sgmii";
	status = "okay";
};

&gmac1 {
	clocks = <&sys_clk>,
		 <&sys_clk>,
		 <&gmac_ts_clk>;
	clock-names = "stmmaceth", "pclk", "ptp_ref";
	phy-handle = <&mdio_gmac1_phy4>;
	phy-mode = "sgmii";
	status = "okay";
};

&gmac2 {
	clocks = <&sys_clk>,
		 <&sys_clk>,
		 <&gmac_ts_clk>;
	clock-names = "stmmaceth", "pclk", "ptp_ref";
	phy-handle = <&mdio_gmac2_phy1>;
	phy-mode = "sgmii";
	status = "okay";
};

&gmac0_mdio {
	#address-cells = <1>;
	#size-cells = <0>;

	/* GPY212 */
	mdio_gmac0_phy1: ethernet-phy@1 {
		reg = <1>;
	};
};

&gmac1_mdio {
	#address-cells = <1>;
	#size-cells = <0>;

	/* TJA1120B */
	mdio_gmac1_phy4: ethernet-phy@4 {
		reg = <4>;
	};
};

&gmac2_mdio {
	#address-cells = <1>;
	#size-cells = <0>;

	/* TJA1120B */
	mdio_gmac2_phy1: ethernet-phy@1 {
		reg = <1>;
	};
};

&pit2 {
	status = "okay";
};

&uart0 {
	status = "okay";
};

&serdes0 {
	status = "okay";
};

&serdes1 {
	status = "okay";
};

&pcie0 {
	status = "okay";
};

&qspi {
	status = "okay";
};

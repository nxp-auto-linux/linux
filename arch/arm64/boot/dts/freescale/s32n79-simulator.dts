/dts-v1/;
#include "s32n79.dtsi"
#include "dt-bindings/memory/s32n7-carv.h"

/ {
	model = "NXP S32N79-SIM";
	compatible = "nxp,s32n79-sim", "nxp,s32n79";

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0 0x80000000 0 0x80000000>;
	};

	clocks {
		sys_clk: sys_clk {
			compatible = "fixed-clock";
			clock-frequency = <100000000>;
			#clock-cells = <0>;
		};
	};

	virtio@43000000 {
		compatible = "virtio,mmio";
		reg = <0x0 0x5c000000 0 0x10000>;
		interrupts = <GIC_SPI 20 IRQ_TYPE_LEVEL_HIGH>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* CAR-V NET */
		carv0_reserved: carv-reserved@d1000000 {
			compatible = "shared-dma-pool";
			/* 1 MB */
			reg = <0 0xd1000000 0 0x100000>;
			no-map;
			status = "okay";
		};

		carv0_vdev0vring0: vdev0vring0@d1100000 {
			compatible = "shared-dma-pool";
			/* 16 KB */
			reg = <0 0xd1100000 0 0x4000>;
			no-map;
			status = "okay";
		};

		carv0_vdev0vring1: vdev0vring1@d1104000 {
			compatible = "shared-dma-pool";
			/* 16 KB */
			reg = <0 0xd1104000 0 0x4000>;
			no-map;
			status = "okay";
		};

		carv0_vdev0buffer: vdev0buffer@d1108000 {
			compatible = "shared-dma-pool";
			/* 16 KB */
			reg = <0 0xd1108000 0 0x4000>;
			no-map;
			status = "okay";
		};

		carv0_packet_sram: packet-sram@d1110000 {
			compatible = "shared-dma-pool";
			/* 16 KB */
			reg = <0 0xd1110000 0 0x4000>;
			no-map;
			status = "okay";
		};

		/* CAR-V NET */
		carv1_reserved: carv-reserved@d2000000 {
			compatible = "shared-dma-pool";
			/* 1 MB */
			reg = <0 0xd2000000 0 0x100000>;
			no-map;
			status = "okay";
		};
	};
};

&irqsteer0_coss {
	status = "okay";
};

&uart0 {
	status = "okay";
};

&cdma_iep {
	status = "disabled";
};

&ufshc {
	lanes-per-direction = <1>;
	status = "okay";
};

&usdhc0 {
	disable-wp;
	status = "okay";
};

&carv0 {
	firmware-name = "s32n7-carvnet.fw";
	memory-region = <&carv0_reserved>, <&carv0_vdev0vring0>,
			<&carv0_vdev0vring1>, <&carv0_vdev0buffer>, <&carv0_packet_sram>;
	memory-region-names = "carv-reserved","vdev0vring0",
			"vdev0vring1","vdev0buffer","packet-sram";
	nxp,s32n7-carv-mem-region-types = <CARV_MEM_NONCOHERENT>,<CARV_MEM_NONCOHERENT>,
			<CARV_MEM_NONCOHERENT>,<CARV_MEM_NONCOHERENT>,<CARV_MEM_SHARED>;

	status = "okay";
};

&carv1 {
	firmware-name = "s32n7-carvnet.fw";
	memory-region = <&carv1_reserved>;
	memory-region-names = "carv-reserved";
	nxp,s32n7-carv-mem-region-types = <CARV_MEM_COHERENT>;
	status = "okay";
};

&netc_switch_port0 {
	status = "okay";
	phy-mode = "internal";
	fixed-link {
		speed = <1000>;
		full-duplex;
	};
};

&netc_switch_port1 {
	status = "okay";
	phy-mode = "internal";
	fixed-link {
		speed = <1000>;
		full-duplex;
	};
};

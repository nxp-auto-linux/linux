/dts-v1/;
#include "s32n79.dtsi"

/ {
	model = "NXP S32N79-SIM";
	compatible = "nxp,s32n79-sim", "nxp,s32n79";

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0 0x80000000 0 0x80000000>;
	};

	clocks {
		sys_clk: sys_clk {
			compatible = "fixed-clock";
			clock-frequency = <100000000>;
			#clock-cells = <0>;
		};
	};

	virtio@43000000 {
		compatible = "virtio,mmio";
		reg = <0x0 0x5c000000 0 0x10000>;
		interrupts = <GIC_SPI 20 IRQ_TYPE_LEVEL_HIGH>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* CAR-V NET */
		carv0_fw: fw@d1000000 {
			compatible = "shared-dma-pool";
			/* 1 MB */
			reg = <0 0xd1000000 0 0x100000>;
			no-map;
			status = "okay";
		};

		carv0_vdev: vdev@d1100000 {
			compatible = "shared-dma-pool";
			/* 1 MB */
			reg = <0 0xd1100000 0 0x100000>;
			no-map;
			status = "okay";
		};
	};
};

&irqsteer0_coss {
	status = "okay";
};

&uart0 {
	status = "okay";
};

&cdma_iep {
	status = "disabled";
};

&ufshc {
	lanes-per-direction = <1>;
	status = "okay";
};

&usdhc0 {
	disable-wp;
	status = "okay";
};

&carv0 {
	firmware-name = "s32n7-carvnet.fw";
	memory-region = <&carv0_vdev>, <&carv0_fw>;
	memory-region-names = "vdev", "text";
	status = "okay";
};

&netc_switch_port0 {
	status = "okay";
	phy-mode = "internal";
	fixed-link {
		speed = <1000>;
		full-duplex;
	};
};

&netc_switch_port1 {
	status = "okay";
	phy-mode = "internal";
	fixed-link {
		speed = <1000>;
		full-duplex;
	};
};

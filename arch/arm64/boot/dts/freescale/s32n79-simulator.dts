/dts-v1/;
#include "s32n79.dtsi"

/ {
	model = "NXP S32N79-SIM";

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0 0x80000000 0 0x80000000>;
	};

	clocks {
		sys_clk: sys_clk {
			compatible = "fixed-clock";
			clock-frequency = <100000000>;
			#clock-cells = <0>;
		};
	};
};

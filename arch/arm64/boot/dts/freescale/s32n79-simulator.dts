/dts-v1/;
#include "s32n79.dtsi"

/ {
	model = "NXP S32N79-SIM";
	compatible = "nxp,s32n79-sim", "nxp,s32n79";

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0 0x80000000 0 0x80000000>;
	};

	clocks {
		sys_clk: sys_clk {
			compatible = "fixed-clock";
			clock-frequency = <100000000>;
			#clock-cells = <0>;
		};
	};

	virtio@43000000 {
		compatible = "virtio,mmio";
		reg = <0x0 0x5c000000 0 0x10000>;
		interrupts = <GIC_SPI 20 IRQ_TYPE_LEVEL_HIGH>;
	};
};

&irqsteer0_coss {
	status = "okay";
};

&uart0 {
	status = "okay";
};

&netc_iep {
	status = "disabled";
};

&cdma_iep {
	status = "disabled";
};

&ufshc {
	lanes-per-direction = <1>;
	status = "okay";
};

&usdhc0 {
	disable-wp;
	status = "okay";
};
